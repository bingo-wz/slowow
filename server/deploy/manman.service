[Unit]
Description=慢慢业务服务
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=manman_app
Group=manman_app
EnvironmentFile=/etc/manman/server.env
ExecStart=/usr/local/bin/manman-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=manman
StateDirectoryMode=0700
MemoryMax=256M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
